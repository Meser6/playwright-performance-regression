{
  "name": "violations, an active and an expired muting, HTML in keys, titles and the build URL",
  "input": {
    "ci": {
      "branch": "feature/<x>",
      "buildUrl": "javascript:alert(1)",
      "commit": "abc123",
      "provider": "other"
    },
    "config": {
      "advanced": {
        "maxSamplesPerKey": 5000,
        "seed": 1
      },
      "checks": {
        "errors": {
          "enabled": true,
          "limit": {
            "api": 0.05,
            "custom": 0.05
          },
          "margin": {
            "add": 0.02,
            "factor": 1.5,
            "min": 0.05
          },
          "minSamples": 5,
          "statuses": [
            "5xx",
            "FAILED",
            "PENDING"
          ]
        },
        "slowShare": {
          "apdex": {
            "enabled": true,
            "limit": {
              "api": 0.85,
              "custom": 0.85
            },
            "margin": {
              "absolute": 0.05,
              "smallSampleAbsolute": 0.1
            },
            "minSamples": 20
          },
          "t": {
            "api": {
              "max": 2000,
              "medianFactor": 2,
              "min": 500
            },
            "custom": {
              "max": 10000,
              "medianFactor": 2,
              "min": 1000
            }
          },
          "wilson": {
            "enabled": true,
            "limit": {
              "api": 0.05,
              "custom": 0.05
            },
            "margin": {
              "add": 0.02,
              "factor": 1.5,
              "max": 0.15,
              "min": 0.03,
              "smallSampleMin": 0.1
            },
            "minSamples": 20
          }
        },
        "time": {
          "median": {
            "enabled": true,
            "limit": {
              "api": 2000,
              "custom": 5000
            },
            "margin": {
              "minMs": 100,
              "relative": 0.4,
              "smallSampleRelative": 0.8
            },
            "minSamples": 5
          },
          "p99": {
            "enabled": true,
            "limit": {
              "api": 4000,
              "custom": 10000
            },
            "margin": {
              "minGapMs": 50,
              "minGapRelative": 0.1,
              "relative": 0.2
            },
            "minSamples": 100
          },
          "percentile": {
            "enabled": true,
            "level": "p95",
            "limit": {
              "api": 2000,
              "custom": 5000
            },
            "margin": {
              "minMs": 100,
              "relative": 0.4,
              "smallSampleRelative": 0.8
            },
            "minSamples": 20
          }
        }
      },
      "gate": {
        "defaultThresholds": "block",
        "hardLimitFactor": 2,
        "maxFailedTestShare": 0.1,
        "tolerance": 0,
        "warnOnly": false
      },
      "keys": {
        "dropQueryParams": [],
        "extraIdPatterns": [],
        "idPatterns": {
          "email": true,
          "hex": true,
          "mixed": true,
          "number": true,
          "token": true,
          "uuid": true
        },
        "keepQueryValues": [],
        "origins": {},
        "query": "names"
      },
      "measure": {
        "exclude": [
          "/socket.io/"
        ],
        "excludeKnownThirdParty": true,
        "ignoreExtensions": [
          ".js",
          ".mjs",
          ".css",
          ".map",
          ".html",
          ".png",
          ".jpg",
          ".jpeg",
          ".gif",
          ".svg",
          ".webp",
          ".avif",
          ".ico",
          ".woff",
          ".woff2",
          ".ttf",
          ".otf",
          ".eot"
        ],
        "include": [],
        "pendingTimeoutMs": 2000,
        "resourceTypes": [
          "document",
          "xhr",
          "fetch"
        ],
        "successStatuses": [
          "2xx",
          "3xx"
        ]
      },
      "report": {
        "dir": "pw-perf-results",
        "html": true,
        "rawUrls": false
      },
      "run": {
        "env": "qa",
        "keepReporters": [],
        "projects": "auto",
