@@ -0,0 +1,63 @@
+# Performance runs with playwright-performance-regression (pw-perf). Register as its own
+# pipeline, e.g. azure-pipelines.perf.yml. Recommended path (docs/ci.md):
+#   1. Run the pipeline by hand with mode "thresholds". Thresholds come from the same agents
+#      that measure.
+#   2. Download the pw-perf-thresholds artifact and commit its pw-perf-thresholds*.json files.
+#   3. The pipeline runs every Monday with mode "test" and fails on a regression.
+# The exit code comes from reports/pw-perf/outcome.json: 2 (performance regression) ends the job
+# as "succeeded with issues", 3 (tool or config error) fails it.
+trigger: none
+pr: none
+
+parameters:
+  - name: mode
+    displayName: 'test: measurement run, thresholds: derive the thresholds files'
+    type: string
+    default: test
+    values: [test, thresholds]
+
+schedules:
+  - cron: '0 3 * * 1'
+    displayName: Weekly measurement run
+    branches:
+      include:
+        - main
+    always: true
+
+pool:
+  vmImage: ubuntu-latest
+
+jobs:
+  - job: perf
+    timeoutInMinutes: 120
+    variables:
+      PW_PERF_MODE: ${{ parameters.mode }}
+    steps:
+      - task: NodeTool@0
+        inputs:
+          versionSpec: '22.x'
+      - script: npm ci
+        displayName: Install dependencies
+      - script: npx playwright install --with-deps chromium
+        displayName: Install Chromium
+      - bash: |
+          rm -f reports/pw-perf/outcome.json
+          npx playwright test || true
+          code=$(node -p "require('./reports/pw-perf/outcome.json').exitCode" 2>/dev/null || echo 3)
+          if [ "$code" -eq 2 ]; then
+            echo "##vso[task.complete result=SucceededWithIssues;]Performance regression (exit code 2)"
+            exit 0
+          fi
+          exit $code
+        displayName: Performance run
+      - bash: mkdir -p pw-perf-thresholds && cp pw-perf-thresholds*.json pw-perf-thresholds/
+        condition: and(always(), eq('${{ parameters.mode }}', 'thresholds'))
+        displayName: Collect the thresholds files
+      - publish: pw-perf-thresholds
+        artifact: pw-perf-thresholds
+        condition: and(always(), eq('${{ parameters.mode }}', 'thresholds'))
+        displayName: Publish the thresholds files
+      - publish: reports/pw-perf
+        artifact: pw-perf-report
+        condition: always()
+        displayName: Publish the performance report
