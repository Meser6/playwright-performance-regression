+  //   // Playwright resource types that are measured.
+  //   resourceTypes: ['document', 'xhr', 'fetch'],
+  //   // Requests whose URL path ends with one of these extensions are skipped, except resource
+  //   // type 'document'.
+  //   ignoreExtensions: [
