+// Configuration of playwright-performance-regression, written by its guided setup.
+// Only the values that differ from the defaults are set. Every other option is commented out
+// with its default value: uncomment a line (and its enclosing objects) to change it. Objects
+// are merged with the defaults; an array you set replaces the default array. All options:
+// https://github.com/Meser6/playwright-performance-regression/blob/main/docs/configuration.md
+//
+// Most important settings
+//
+// run.passes: How many times your test command runs in one measurement run. More passes give more
+// samples per endpoint and steadier thresholds, but the run takes longer (tests x passes on 1
+// worker).
+//   run: { passes: { test: 5, thresholds: 10 } },
+//
+// run.grep: Measure only the tests whose title or tags match, e.g. tests tagged @perf. Setup and
+// teardown projects still run in full.
+//   run: { grep: '@perf' },
+//
+// thresholds.preset: Headroom added to the measured times when thresholds are derived. 'strict'
+// catches smaller regressions but alarms more often on a noisy environment, 'loose' only flags
+// clear regressions.
+//   thresholds: { preset: 'normal' },
+//
+// run.env: Environment label: each label has its own thresholds files
+// (pw-perf-thresholds.<env>.json). Usually set per run with PW_PERF_ENV=staging instead; see
+// docs/dynamic-environments.md.
+//   run: { env: 'staging' },
+//
+// keys.origins: Short labels for backend hosts in endpoint keys; the baseURL host has no label.
+// Host patterns with * merge random CI hosts, e.g. pr-123.ci.example.com.
+//   keys: { origins: { 'https://auth.example.com': 'auth', 'https://pr-*.ci.example.com': '' } },
+//
+// measure.steps: The duration of your test.step blocks is measured too (on by default), with their
+// own thresholds file (pw-perf-thresholds.steps.json). Step titles are sanitized: ids, e-mails,
+// URLs and secrets do not reach the keys. Set false to measure only the backend requests.
+//   measure: { steps: false },
+//
+// gate.tolerance: How many endpoints may exceed their thresholds before the run fails (a number or
+// a share like "5%"). Values far above a threshold (hardLimitFactor) fail the run anyway.
+//   gate: { tolerance: 0 },
+import { definePerfConfig } from 'playwright-performance-regression';
