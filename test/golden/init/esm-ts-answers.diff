+# Performance runs with playwright-performance-regression (pw-perf). Save as
+# .github/workflows/perf.yml. Recommended path (docs/ci.md):
+#   1. Run the "thresholds" job by hand (Actions > Performance > Run workflow, mode: thresholds).
+#      Thresholds come from the same machines that measure.
+#   2. Download the pw-perf-thresholds artifact and commit its pw-perf-thresholds*.json files.
+#   3. The "measure" job runs every Monday (or by hand, mode: test) and fails on a regression.
+# The exit code comes from reports/pw-perf/outcome.json: 0 ok, 2 performance regression, 3 tool or
+# config error. Not ready to block builds? Add "continue-on-error: true" to the measure job.
+name: Performance
+
+on:
+  schedule:
+    - cron: '0 3 * * 1'
+  workflow_dispatch:
+    inputs:
+      mode:
+        description: 'test: measurement run, thresholds: derive the thresholds files'
+        type: choice
+        options: [test, thresholds]
+        default: test
+
+jobs:
+  thresholds:
+    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'thresholds'
+    runs-on: ubuntu-latest
+    timeout-minutes: 120
+    env:
+      PW_PERF_MODE: thresholds
+    steps:
+      - uses: actions/checkout@v7
+      - uses: actions/setup-node@v7
+        with:
+          node-version: 22
+          cache: npm
+      - run: npm ci
+      - run: npx playwright install --with-deps chromium
+      - name: Thresholds run
+        run: |
+          rm -f reports/pw-perf/outcome.json
+          npm run e2e -- --grep "@smoke" || true
+          exit "$(node -p "require('./reports/pw-perf/outcome.json').exitCode" 2>/dev/null || echo 3)"
+      - name: Upload the thresholds files
+        if: always()
+        uses: actions/upload-artifact@v7
+        with:
+          name: pw-perf-thresholds
+          path: |
+            pw-perf-thresholds*.json
+            reports/pw-perf/
+          retention-days: 30
+
+  measure:
+    if: github.event_name == 'schedule' || inputs.mode == 'test'
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    env:
+      PW_PERF_MODE: test
+    steps:
+      - uses: actions/checkout@v7
+      - uses: actions/setup-node@v7
+        with:
+          node-version: 22
+          cache: npm
+      - run: npm ci
+      - run: npx playwright install --with-deps chromium
+      - name: Measurement run
+        run: |
+          rm -f reports/pw-perf/outcome.json
+          npm run e2e -- --grep "@smoke" || true
+          exit "$(node -p "require('./reports/pw-perf/outcome.json').exitCode" 2>/dev/null || echo 3)"
+      - name: Upload the performance report
+        if: always()
+        uses: actions/upload-artifact@v7
+        with:
+          name: pw-perf-report
+          path: reports/pw-perf/
+          retention-days: 30
