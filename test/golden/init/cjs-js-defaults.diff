+// Configuration of playwright-performance-regression, written by "npx pw-perf init".
+// Only the values that differ from the defaults are set. All options:
+// https://github.com/Meser6/playwright-performance-regression/blob/main/docs/configuration.md
+import { definePerfConfig } from 'playwright-performance-regression';
+
+export default definePerfConfig({
+  gate: {
+    // Report regressions without failing the run; remove after the first weeks.
+    warnOnly: true,
+  },
+
+  // Options changed most often, with their default values:
+  // run: { repeat: { test: 5, thresholds: 10 }, projects: 'auto', keepReporters: [] },
+  // measure: { exclude: ['/socket.io/'] },
+  // gate: { warnOnly: false, tolerance: 0, maxFailedTestShare: 0.1 },
+  // thresholds: { dir: '.' },
+  // report: { dir: 'perf-results' },
+});
