+# Performance runs with playwright-performance-regression (pw-perf). Save as
+# .gitlab/perf.gitlab-ci.yml and include it from .gitlab-ci.yml. Recommended path (docs/ci.md):
+#   1. Start the manual "perf-thresholds" job. Thresholds come from the same runners that measure.
+#   2. Download its artifacts and commit the pw-perf-thresholds*.json files.
+#   3. The "perf" job runs in scheduled pipelines (create a weekly schedule) and can be started by
+#      hand; it fails on a regression.
+# The exit code comes from reports/pw-perf/outcome.json: 2 (performance regression) is a soft
+# failure, 3 (tool or config error) fails the job.
+.perf:
+  image: node:22
+  before_script:
+    - npm ci
+    - npx playwright install --with-deps chromium
+  script:
+    - rm -f reports/pw-perf/outcome.json
+    - pnpm exec playwright test || true
+    - exit "$(node -p "require('./reports/pw-perf/outcome.json').exitCode" 2>/dev/null || echo 3)"
+
+perf-thresholds:
+  extends: .perf
+  timeout: 2h
+  variables:
+    PW_PERF_MODE: thresholds
+  rules:
+    - when: manual
+  allow_failure: true
+  artifacts:
+    when: always
+    paths:
+      - pw-perf-thresholds*.json
+      - reports/pw-perf/
+    expire_in: 30 days
+
+perf:
+  extends: .perf
+  timeout: 1h
+  variables:
+    PW_PERF_MODE: test
+  rules:
+    - if: $CI_PIPELINE_SOURCE == "schedule"
+    - when: manual
+      allow_failure: true
+  allow_failure:
+    exit_codes: 2
+  artifacts:
+    when: always
+    paths:
+      - reports/pw-perf/
+    expire_in: 30 days
