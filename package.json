{
  "name": "playwright-performance-regression",
  "version": "0.0.0",
  "private": true,
  "description": "Catch backend performance regressions from the Playwright tests you already have.",
  "keywords": [
    "playwright",
    "performance",
    "regression",
    "benchmark",
    "response-time",
    "latency",
    "api",
    "e2e",
    "thresholds",
    "performance-budget",
    "ci"
  ],
  "homepage": "https://github.com/Meser6/playwright-performance-regression#readme",
  "bugs": {
    "url": "https://github.com/Meser6/playwright-performance-regression/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meser6/playwright-performance-regression.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "require": {
        "types": "./dist/config.d.cts",
        "default": "./dist/config.cjs"
      }
    },
    "./fixture": {
      "import": {
        "types": "./dist/fixture.d.ts",
        "default": "./dist/fixture.js"
      },
      "require": {
        "types": "./dist/fixture.d.cts",
        "default": "./dist/fixture.cjs"
      }
    },
    "./test": {
      "import": {
        "types": "./dist/test.d.ts",
        "default": "./dist/test.js"
      },
      "require": {
        "types": "./dist/test.d.cts",
        "default": "./dist/test.cjs"
      }
    },
    "./reporter": {
      "import": {
        "types": "./dist/reporter.d.ts",
        "default": "./dist/reporter.js"
      },
      "require": {
        "types": "./dist/reporter.d.cts",
        "default": "./dist/reporter.cjs"
      }
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "bin": {
    "playwright-performance-regression": "./dist/cli.js",
    "pw-perf": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && node scripts/build-html-assets.mjs --check && tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/html/template",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:ac": "node scripts/check-ac-coverage.mjs",
    "check:pr-title": "node scripts/check-pr-title.mjs",
    "gen:types": "node scripts/generate-types.mjs",
    "check:types-generated": "node scripts/generate-types.mjs --check",
    "gen:html": "node scripts/build-html-assets.mjs",
    "check:html-generated": "node scripts/build-html-assets.mjs --check",
    "gen:ci": "node scripts/build-ci-templates.mjs",
    "check:ci-generated": "node scripts/build-ci-templates.mjs --check",
    "gen:docs": "node scripts/build-config-docs.mjs",
    "check:docs-generated": "node scripts/build-config-docs.mjs --check",
    "check:packages": "node scripts/check-packages.mjs",
    "publint": "publint --strict && publint --strict create",
    "attw": "attw --pack . --profile node16"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.57.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.16.1",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.57.0",
    "@types/node": "^22.20.5",
    "ajv": "8.20.0",
    "axe-core": "4.14.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "^17.14.0",
    "json-schema-to-typescript": "16.0.0",
    "playwright-bdd": "9.2.1",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "tsup": "9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
