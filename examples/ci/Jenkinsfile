// Performance runs with playwright-performance-regression (pw-perf). Use as the script of a
// pipeline job, e.g. "Jenkinsfile.perf". Recommended path (docs/ci.md):
//   1. Build with parameters, MODE=thresholds. Thresholds come from the same agents that measure.
//   2. Download the archived pw-perf-thresholds*.json files and commit them.
//   3. The job runs every Monday with MODE=test and fails on a regression.
// The exit code comes from reports/pw-perf/outcome.json: 2 (performance regression) marks the
// build UNSTABLE, 3 (tool or config error) fails it.
pipeline {
  agent any
  parameters {
    choice(name: 'MODE', choices: ['test', 'thresholds'], description: 'test: measurement run, thresholds: derive the thresholds files')
  }
  options {
    timeout(time: 120, unit: 'MINUTES')
  }
  triggers {
    cron('H 3 * * 1')
  }
  environment {
    PW_PERF_MODE = "${params.MODE ?: 'test'}"
  }
  stages {
    stage('Performance') {
      steps {
        sh 'npm ci'
        sh 'npx playwright install --with-deps chromium'
        sh 'rm -f reports/pw-perf/outcome.json'
        sh(script: 'npm run e2e', returnStatus: true)
        script {
          def code = sh(script: 'node -p "require(\'./reports/pw-perf/outcome.json\').exitCode" 2>/dev/null || echo 3', returnStdout: true).trim()
          if (code == '2') {
            unstable('Performance regression (exit code 2)')
          } else if (code != '0') {
            error("Performance run failed with exit code ${code}")
          }
        }
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: 'pw-perf-thresholds*.json, reports/pw-perf/**', allowEmptyArchive: true
    }
  }
}
