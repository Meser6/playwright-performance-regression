// Performance measurement run with playwright-performance-regression (pw-perf).
// Use as the script of a pipeline job, e.g. "Jenkinsfile.perf". Exit code 2 (performance
// regression) marks the build UNSTABLE, 3 (tool or config error) fails it. The report in
// perf-results/ is archived also when the run fails.
pipeline {
  agent any
  options {
    timeout(time: 60, unit: 'MINUTES')
  }
  triggers {
    cron('H 3 * * *')
  }
  stages {
    stage('Performance') {
      steps {
        sh 'npm ci'
        sh 'npx playwright install --with-deps chromium'
        script {
          def code = sh(script: 'npx pw-perf test', returnStatus: true)
          if (code == 2) {
            unstable('Performance regression (exit code 2)')
          } else if (code != 0) {
            error("Measurement run failed with exit code ${code}")
          }
        }
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: 'perf-results/**', allowEmptyArchive: true
    }
  }
}
